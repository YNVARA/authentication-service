      "updated": 1766676217141,
      "link": null,
      "locked": false,
      "text": "FLOW ATAU ALUR:\n\n1. link yang dikirim dalam email di klik\n2. masuk front end, parsing isi parameter token nya\n3. gunakan token itu untuk fetching ke api\n4. response :\n    - token expired => arahkan ke halaman resend token\n    - token belum expired => lakukan update status",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FLOW ATAU ALUR:\n\n1. link yang dikirim dalam email di klik\n2. masuk front end, parsing isi parameter token nya\n3. gunakan token itu untuk fetching ke api\n4. response :\n    - token expired => arahkan ke halaman resend token\n    - token belum expired => lakukan update status",
      "autoResize": true,
      "lineHeight": 1.25
    },
