    {
      "id": "DxujqfL20wr8IPMXQTWwL",
      "type": "text",
      "x": 151,
      "y": 439.5,
      "width": 822.579345703125,
      "height": 775,
      "angle": 0,
      "strokeColor": "#1e1e1e",
