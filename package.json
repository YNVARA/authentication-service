{
    "name": "authentication-service",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "rm -rf dist && mkdir -p dist && bun build ./src/server.ts --compile --minify --target=bun-linux-x64-modern --outfile ./dist/storage-service",
